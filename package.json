    "@stripe/stripe-js": "^9.8.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "gsap": "^3.15.0",
    "next": "^16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.4",
    "sharp": "^0.35.3",
    "stripe": "^22.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
